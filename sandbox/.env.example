# ============================================================================
# PyOz Sandbox — Environment Variables
# Copy this file to .env and fill in your API keys.
#
#   cp .env.example .env
#   nano .env
# ============================================================================

# ── LLM API Keys (at least one required) ─────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# ── Database Credentials (defaults work out of the box) ──────
# Change these if you want custom credentials.
POSTGRES_USER=pyoz
POSTGRES_PASSWORD=pyoz_secret
POSTGRES_DB=app_db

MYSQL_USER=pyoz
MYSQL_PASSWORD=pyoz_secret
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_DB=app_db

MONGO_USER=pyoz
MONGO_PASSWORD=pyoz_secret
MONGO_DB=app_db

REDIS_PASSWORD=

RABBITMQ_USER=pyoz
RABBITMQ_PASSWORD=pyoz_secret

MINIO_ACCESS_KEY=pyoz
MINIO_SECRET_KEY=pyoz_secret_key

# ── External Port Mapping (change to avoid conflicts) ────────
# These are the ports exposed on your HOST machine.
# Internal Docker ports remain unchanged.
POSTGRES_EXTERNAL_PORT=5433
MYSQL_EXTERNAL_PORT=3306
MONGO_EXTERNAL_PORT=27017
REDIS_EXTERNAL_PORT=6379
KAFKA_EXTERNAL_PORT=9092
RABBITMQ_EXTERNAL_PORT=5672
ES_EXTERNAL_PORT=9200
